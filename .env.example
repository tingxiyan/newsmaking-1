# ==================== API 密钥配置 ====================
# 将此文件复制为 .env 并填入您的真实密钥
# 注意：.env 文件已被 .gitignore 忽略，切勿提交到代码仓库

# DeepSeek（推荐，价格便宜响应快）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 豆包（火山引擎方舟）
DOUBAO_API_KEY=your-doubao-ark-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# 自定义模型（可选）
CUSTOM_API_KEY=your-custom-key-here
